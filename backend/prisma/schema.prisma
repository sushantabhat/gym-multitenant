generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS FOR ROLE-BASED ACCESS CONTROL
// ------------------------------------------------------
enum TenantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  PLATFORM_ADMIN
  GYM_ADMIN
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

// ------------------------------------------------------
// 1. TENANT (THE GYM ORGANIZATION)
// ------------------------------------------------------
model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(PENDING) // Gyms must be verified!
  
  // Custom Branding (White-labeling)
  brandColor String?     @default("#0f172a") // slate-900 default
  logoUrl    String?
  welcomeMessage String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  users     User[]
  featureFlags FeatureFlag[]
  attendance Attendance[]
  classes   Class[]
  plans     MembershipPlan[]
}

// ------------------------------------------------------
// 2. USER (MEMBERS, GYM ADMINS, AND PLATFORM ADMINS)
// ------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String?   // Optional because regular members don't need passwords yet
  phone_number String?
  role         UserRole @default(MEMBER)
  
  // Link to the Tenant
  tenantId     String? // Optional because PLATFORM_ADMIN doesn't belong to a specific gym!
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendance Attendance[]
  classBookings ClassBooking[]
  subscriptions Subscription[]
}

// ------------------------------------------------------
// 2.5 ATTENDANCE TRACKING
// ------------------------------------------------------
model Attendance {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  checkInTime DateTime @default(now())
}

// ------------------------------------------------------
// 3. FEATURE FLAGS
// Allows toggling features on and off dynamically
// ------------------------------------------------------
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String
  isEnabled   Boolean  @default(false)
  description String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId]) // A gym can only have one flag per key
}

// ------------------------------------------------------
// 4. CLASSES & SCHEDULING
// ------------------------------------------------------
model Class {
  id          String   @id @default(uuid())
  name        String
  description String?
  instructor  String
  capacity    Int
  startTime   DateTime
  duration    Int      // duration in minutes
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bookings    ClassBooking[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassBooking {
  id        String   @id @default(uuid())
  
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookedAt  DateTime @default(now())
  
  @@unique([classId, userId]) // Prevent double-booking
}

// ------------------------------------------------------
// 5. MEMBERSHIP PLANS & SUBSCRIPTIONS
// ------------------------------------------------------
model MembershipPlan {
  id             String   @id @default(uuid())
  name           String
  durationMonths Int
  price          Float
  access         String?  // E.g. 'Gym floor', 'Gym + classes', 'Full access'
  benefits       String[]
  
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  subscriptions  Subscription[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId    String
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  startDate DateTime @default(now())
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
